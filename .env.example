# EPO Open Patent Services credentials — https://developers.epo.org
# Copy this file to .env and fill in your consumer key / consumer secret.
# .env is gitignored and never committed.
EPO_OPS_CLIENT_ID=your-consumer-key-here
EPO_OPS_CLIENT_SECRET=your-consumer-secret-here

# Google Cloud BigQuery — Google Patents public dataset (patents-public-data.patents.publications)
# GOOGLE_APPLICATION_CREDENTIALS: absolute path to a service-account JSON key (gitignored; never commit).
# GCP_PROJECT_ID: the GCP project that owns the service account / billing for BigQuery.
# These are optional — if absent or unauthenticated, the BigQuery adapter degrades gracefully
# (falls back to the existing HTTP live-adapter path) rather than failing the pipeline.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GCP_PROJECT_ID=your-gcp-project-id
